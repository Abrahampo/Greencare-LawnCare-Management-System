@page "/appointments/create"

@using Greencare.Models
@using Microsoft.AspNetCore.Components.Forms

@inject Greencare.Data.GreencareContext Context
@inject NavigationManager Navigation

<h3>Add Appointment</h3>

<EditForm Model="@appointment"
          OnSubmit="@CreateAppointment"
          FormName="CreateAppointmentForm">

    <div class="mb-3">
        <label>Customer ID</label>
        <InputNumber class="form-control"
                     @bind-Value="appointment.CustomerID" />
    </div>

    <div class="mb-3">
        <label>Employee ID</label>
        <InputNumber class="form-control"
                     @bind-Value="appointment.EmployeeID" />
    </div>

    <div class="mb-3">
        <label>Service ID</label>
        <InputNumber class="form-control"
                     @bind-Value="appointment.ServiceID" />
    </div>

    <div class="mb-3">
        <label>Appointment Date</label>
        <InputDate class="form-control"
                   @bind-Value="appointment.AppointmentDate" />
    </div>

    <div class="mb-3">
        <label>Status</label>
        <InputText class="form-control"
                   @bind-Value="appointment.Status" />
    </div>

    <button type="submit"
            class="btn btn-primary">
        Save
    </button>

    <a href="/appointments"
       class="btn btn-secondary ms-2">
        Cancel
    </a>

</EditForm>

@code {

    private Appointment appointment = new();

    private async Task CreateAppointment()
{
    appointment.CustomerID = 13;
    appointment.EmployeeID = 1;
    appointment.ServiceID = 11;

    appointment.Status = "Scheduled";
    appointment.AppointmentDate = DateTime.Today;

    await Context.Appointments.AddAsync(appointment);

    await Context.SaveChangesAsync();

    Navigation.NavigateTo("/appointments", true);
}
}