@page "/appointments/delete/{id:int}"

@using Greencare.Models
@using Microsoft.AspNetCore.Components.Forms

@inject Greencare.Data.GreencareContext Context
@inject NavigationManager Navigation

<h3>Delete Appointment</h3>

@if (appointment == null)
{
    <p>Loading...</p>
}
else
{
    <p>
        Delete Appointment ID:
        <strong>@appointment.AppointmentID</strong>?
    </p>

    <EditForm Model="@appointment"
              OnSubmit="@DeleteAppointment"
              FormName="DeleteAppointmentForm">

        <button type="submit"
                class="btn btn-danger">
            Delete
        </button>

        <a href="/appointments"
           class="btn btn-secondary ms-2">
            Cancel
        </a>

    </EditForm>
}

@code {

    [Parameter]
    public int id { get; set; }

    private Appointment? appointment;

    protected override async Task OnInitializedAsync()
    {
        appointment = await Context.Appointments.FindAsync(id);
    }

    private async Task DeleteAppointment()
    {
        if (appointment != null)
        {
            Context.Appointments.Remove(appointment);

            await Context.SaveChangesAsync();
        }

        Navigation.NavigateTo("/appointments", true);
    }
}