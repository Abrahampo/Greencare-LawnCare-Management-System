@page "/appointments/edit/{id:int}"
@rendermode InteractiveServer

@using Greencare.Models
@using Microsoft.AspNetCore.Components.Forms

@inject Greencare.Data.GreencareContext Context
@inject NavigationManager Navigation

<h3>Edit Appointment</h3>

@if (appointment == null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="@appointment"
              OnSubmit="@SaveAppointment"
              FormName="EditAppointmentForm">

        <div class="mb-3">
            <label>Status</label>
            <InputText class="form-control"
                       @bind-Value="appointment.Status" />
        </div>

        <button type="submit"
                class="btn btn-primary">
            Save
        </button>

        <a href="/appointments"
           class="btn btn-secondary ms-2">
            Cancel
        </a>

    </EditForm>
}

@code {

    [Parameter]
    public int id { get; set; }

    private Appointment? appointment;

    protected override async Task OnInitializedAsync()
    {
        appointment = await Context.Appointments.FindAsync(id);
    }

    private async Task SaveAppointment()
    {
        await Context.SaveChangesAsync();

        Navigation.NavigateTo("/appointments", true);
    }
}