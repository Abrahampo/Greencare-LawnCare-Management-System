@page "/invoices/create"
@rendermode InteractiveServer

@using Greencare.Models

@inject Greencare.Data.GreencareContext Context
@inject NavigationManager Navigation

<h3>Add Invoice</h3>

<EditForm Model="@invoice"
          OnValidSubmit="@CreateInvoice"
          FormName="CreateInvoiceForm">
           <DataAnnotationsValidator />

    <div class="mb-3">
        <label>Appointment ID</label>
        <InputNumber TValue="int"
                     class="form-control"
                     @bind-Value="invoice.AppointmentID" />
    </div>

    <div class="mb-3">
        <label>Invoice Date</label>
        <InputDate class="form-control"
                   @bind-Value="invoice.InvoiceDate" />
    </div>

    <div class="mb-3">
        <label>Total Amount</label>
        <InputNumber TValue="decimal"
                     class="form-control"
                     @bind-Value="invoice.TotalAmount" />
    </div>

    <div class="mb-3">
        <label>Payment Status</label>
        <InputText class="form-control"
                   @bind-Value="invoice.PaymentStatus" />
    </div>

  


    <button type="submit"
            class="btn btn-primary">
        Save
    </button>

    <a href="/invoices"
       class="btn btn-secondary ms-2">
        Cancel
    </a>

</EditForm>

@code {

    private Invoice invoice = new()
    {
        InvoiceDate = DateTime.Today
    };

    private async Task CreateInvoice()
    {
        Context.Invoices.Add(invoice);

        await Context.SaveChangesAsync();

        Navigation.NavigateTo("/invoices", true);
    }
}