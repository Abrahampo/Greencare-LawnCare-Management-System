@page "/invoices/edit/{id:int}"

@using Greencare.Models
@using Microsoft.AspNetCore.Components.Forms

@inject Greencare.Data.GreencareContext Context
@inject NavigationManager Navigation

<h3>Edit Invoice</h3>

@if (invoice == null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="@invoice"
              OnSubmit="@SaveInvoice"
              FormName="EditInvoiceForm">

        <div class="mb-3">
            <label>Total Amount</label>
            <InputNumber TValue="decimal"
                         class="form-control"
                         @bind-Value="invoice.TotalAmount" />
        </div>

        <div class="mb-3">
            <label>Payment Status</label>
            <InputText class="form-control"
                       @bind-Value="invoice.PaymentStatus" />
        </div>

        <button type="submit"
                class="btn btn-primary">
            Save
        </button>

        <a href="/invoices"
           class="btn btn-secondary ms-2">
            Cancel
        </a>

    </EditForm>
}

@code {

    [Parameter]
    public int id { get; set; }

    private Invoice? invoice;

    protected override async Task OnInitializedAsync()
    {
        invoice = await Context.Invoices.FindAsync(id);
    }

    private async Task SaveInvoice()
    {
        if (invoice != null)
        {
            invoice.TotalAmount = 600;
            invoice.PaymentStatus = "Paid";

            Context.Invoices.Update(invoice);

            await Context.SaveChangesAsync();
        }

        Navigation.NavigateTo("/invoices", true);
    }
}