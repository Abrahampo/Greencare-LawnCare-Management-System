@page "/properties/create"
@rendermode InteractiveServer
@using Greencare.Models
@using Microsoft.AspNetCore.Components.Forms

@inject Greencare.Data.GreencareContext Context
@inject NavigationManager Navigation

<h3>Add Property</h3>

<EditForm Model="@property"
          OnSubmit="@CreateProperty"
          FormName="CreatePropertyForm">

    <div class="mb-3">
        <label>Street Address</label>
        <InputText class="form-control"
                   @bind-Value="property.StreetAddress" />
    </div>

    <div class="mb-3">
        <label>City</label>
        <InputText class="form-control"
                   @bind-Value="property.City" />
    </div>

    <div class="mb-3">
        <label>State</label>
        <InputText class="form-control"
                   @bind-Value="property.State" />
    </div>

    <div class="mb-3">
        <label>Zip Code</label>
        <InputText class="form-control"
                   @bind-Value="property.ZipCode" />
    </div>

    <div class="mb-3">
        <label>Lot Size</label>
        <InputNumber class="form-control"
                     @bind-Value="property.LotSize" />
    </div>

    <div class="mb-3">
        <label>Customer ID</label>
        <InputNumber class="form-control"
                     @bind-Value="property.CustomerID" />
    </div>
  

    <button type="submit"
            class="btn btn-primary">
        Save
    </button>

    <a href="/properties"
       class="btn btn-secondary ms-2">
        Cancel
    </a>

</EditForm>

@code {

    private Property property = new();

    private async Task CreateProperty()
{
    

    Context.Properties.Add(property);

    await Context.SaveChangesAsync();

    Navigation.NavigateTo("/properties", true);
}
}