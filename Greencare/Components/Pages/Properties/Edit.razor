@page "/properties/edit/{id:int}"

@using Greencare.Models
@using Microsoft.AspNetCore.Components.Forms

@inject Greencare.Data.GreencareContext Context
@inject NavigationManager Navigation

<h3>Edit Property</h3>

@if (property == null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="@property"
              OnSubmit="@SaveProperty"
              FormName="EditPropertyForm">

        <div class="mb-3">
            <label>Street Address</label>
            <InputText class="form-control"
                       @bind-Value="property.StreetAddress" />
        </div>

        <div class="mb-3">
            <label>City</label>
            <InputText class="form-control"
                       @bind-Value="property.City" />
        </div>

        <div class="mb-3">
            <label>State</label>
            <InputText class="form-control"
                       @bind-Value="property.State" />
        </div>

        <div class="mb-3">
            <label>Zip Code</label>
            <InputText class="form-control"
                       @bind-Value="property.ZipCode" />
        </div>

        <div class="mb-3">
            <label>Lot Size</label>
            <InputNumber class="form-control"
                         @bind-Value="property.LotSize" />
        </div>

        <div class="mb-3">
            <label>Customer ID</label>
            <InputNumber class="form-control"
                         @bind-Value="property.CustomerID" />
        </div>

        <button type="submit"
                class="btn btn-primary">
            Save
        </button>

        <a href="/properties"
           class="btn btn-secondary ms-2">
            Cancel
        </a>

    </EditForm>
}

@code {

    [Parameter]
    public int id { get; set; }

    private Property? property;

    protected override async Task OnInitializedAsync()
    {
        property = await Context.Properties.FindAsync(id);
    }

    private async Task SaveProperty()
    {
        await Context.SaveChangesAsync();

        Navigation.NavigateTo("/properties", true);
    }
}