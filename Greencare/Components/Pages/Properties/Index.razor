@page "/properties"

@using Greencare.Models
@using Microsoft.EntityFrameworkCore
@inject Greencare.Data.GreencareContext Context

<h3>Properties</h3>

<p>
    <a href="/properties/create" class="btn btn-primary">
        Add Property
    </a>
</p>

@if (properties == null)
{
    <p>Loading...</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Address</th>
                <th>City</th>
                <th>State</th>
                <th>Zip</th>
                <th>Lot Size</th>
                <th>Customer ID</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
        @foreach (var property in properties)
        {
            <tr>
                <td>@property.StreetAddress</td>
                <td>@property.City</td>
                <td>@property.State</td>
                <td>@property.ZipCode</td>
                <td>@property.LotSize</td>
                <td>@property.CustomerID</td>

                <td>
                    <a href="/properties/edit/@property.PropertyID"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a href="/properties/delete/@property.PropertyID"
                       class="btn btn-danger btn-sm ms-2">
                        Delete
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<Property>? properties;

    protected override async Task OnInitializedAsync()
    {
        properties = await Context.Properties.ToListAsync();
    }
}