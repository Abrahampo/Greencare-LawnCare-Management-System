@page "/services/create"

@using Greencare.Models
@using Microsoft.AspNetCore.Components.Forms

@inject Greencare.Data.GreencareContext Context
@inject NavigationManager Navigation

<h3>Add Service</h3>

<EditForm Model="@service"
          OnSubmit="@CreateService"
          FormName="CreateServiceForm">

    <div class="mb-3">
        <label>Service Name</label>
        <InputText class="form-control"
                   @bind-Value="service.ServiceName" />
    </div>

    <div class="mb-3">
        <label>Description</label>
        <InputText class="form-control"
                   @bind-Value="service.Description" />
    </div>

    <div class="mb-3">
        <label>Price</label>
        <InputNumber TValue="decimal"
                     class="form-control"
                     @bind-Value="service.Price" />
    </div>

    <button type="submit" class="btn btn-primary">
        Save
    </button>

    <a href="/services"
       class="btn btn-secondary ms-2">
        Cancel
    </a>

</EditForm>

@code {
    private Service service = new();

    private async Task CreateService()
    {
       
        Context.Services.Add(service);

        await Context.SaveChangesAsync();

        Navigation.NavigateTo("/services", true);
    }
}